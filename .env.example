# Copy to .env (git-ignored). Never commit real values.

# Instagram API with Instagram Login (graph.instagram.com)
IG_TOKEN=
IG_USER_ID=
# graph.facebook.com for the unified-login EAA token we use; graph.instagram.com for IGAA tokens
IG_API=https://graph.facebook.com/v23.0
# comma-separated collab post IDs to watch for comments (auto-filled by scripts/list_media.py)
IG_WATCH_MEDIA_IDS=
# DMs arrive via the `messages` webhook (POST /webhook); same value goes in the Meta dashboard
IG_WEBHOOK_VERIFY_TOKEN=
# optional: Meta app secret -> enforce X-Hub-Signature-256 on webhook POSTs
IG_APP_SECRET=
# only answer comments newer than this many minutes before the poller started
COMMENT_LOOKBACK_MIN=10

# Careem MCP (hackathon production client, public PKCE client — no secret)
CAREEM_MCP_URL=https://mcp.careemapis.com/mcp
CAREEM_SANDBOX_MCP_URL=http://127.0.0.1:8787/mcp
CAREEM_CLIENT_ID=17ccbccd-fb56-43b9-8b2e-198c08a0a207
CAREEM_REDIRECT_URI=http://localhost:8080/callback
# openid profile offline_access is documented, but Identity rejected offline_access for us
CAREEM_SCOPES=openid xcma profile
# production | sandbox  (sandbox = python -m sandbox.ctl start, no login needed)
CAREEM_TARGET=sandbox
# written by scripts/login_careem.py
CAREEM_REFRESH_TOKEN=
# venue coordinates — sent on every Careem call
DEMO_LAT=
DEMO_LNG=
DEMO_LOCATION_LABEL=Demo venue

# Bedrock (organizer setup)
AWS_REGION=us-east-1
AGENT_MODEL_ID=global.anthropic.claude-sonnet-5-5
FAST_MODEL_ID=global.anthropic.claude-haiku-5-5

# Modes
PUBLIC_BASE_URL=
ORDER_MODE=basket        # basket | sandbox_checkout | live_checkout
# live_checkout spends REAL money and additionally requires ALLOW_REAL_MONEY=1 (else basket)
ALLOW_REAL_MONEY=
AGENT_MODE=live          # live | cached | scripted   (dashboard can switch at runtime)
POLL_SECONDS=4

# Local
DB_PATH=genie.db
WEB_PORT=8000
